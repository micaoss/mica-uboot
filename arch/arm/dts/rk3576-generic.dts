/*
 * Minimal generic DT for RK3576 with eMMC, SD-card and USB OTG enabled
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "rk3576.dtsi"

/ {
	model = "Generic RK3576";
	compatible = "rockchip,rk3576";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
	};

	sdmmc_reg: sdmmc-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_pwr>;
		regulator-boot-on;
		startup-delay-us = <5000>;
		bootph-pre-ram;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};
};

&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&sdmmc {
	bootph-pre-ram;
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-mmc;
	no-sdio;
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	vmmc-supply = <&sdmmc_reg>;
	status = "okay";
};

&gpio0 {
	bootph-pre-ram;
};

&pinctrl {
	sdmmc-pwr-en {
		sdmmc_pwr: sdmmc-pwr {
			rockchip,pins = <0 RK_PB6 0 &pcfg_pull_none>;
			bootph-pre-ram;
		};
	};
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&uart0 {
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&usb_drd0_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&u2phy0_otg>;
	phy-names = "usb2-phy";
	status = "okay";
};

/ {
	bootstd {
		compatible = "u-boot,boot-std";
		/* Rescue policy: eMMC first, SD as fallback, then USB. */
		bootdev-order = "mmc0", "mmc1", "usb";
	};

	leds {
		compatible = "gpio-leds";

		led_work: led-work {
			label = "work";
			gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_HIGH>;
		};

		led_status_red: led-status-red {
			label = "status-red";
			gpios = <&gpio4 RK_PC7 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_status_blue: led-status-blue {
			label = "status-blue";
			gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	vcc5v0_3v3: vcc5v0-3v3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_3v3_pwren>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&gpio2 {
	usb-host1-pwren-hog {
		gpio-hog;
		gpios = <RK_PA6 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-host1-pwren";
	};

	usb-host3-pwren-hog {
		gpio-hog;
		gpios = <RK_PA7 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-host3-pwren";
	};
};

&pinctrl {
	vcc5v0-3v3-en {
		vcc5v0_3v3_pwren: vcc5v0-3v3-pwren {
			rockchip,pins = <4 RK_PB2 0 &pcfg_pull_none>;
		};
	};
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
};

&usb_drd1_dwc3 {
	dr_mode = "host";
	maximum-speed = "high-speed";
	phys = <&u2phy1_otg>;
	phy-names = "usb2-phy";
	status = "okay";
};
